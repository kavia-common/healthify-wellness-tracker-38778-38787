# Healthify Frontend - Environment Variables (Create React App)
# Copy this file to `.env` and adjust values for your environment.
# NOTE: Only variables prefixed with REACT_APP_ are embedded at build time by CRA.

# Base API URL used for all REST calls (preferred). Example: https://api.example.com
REACT_APP_API_BASE=http://localhost:5001

# Alternative/back-compat for API base. If REACT_APP_API_BASE is not set, this will be used.
# Example: https://backend.example.com
REACT_APP_BACKEND_URL=

# Public URL of this frontend (without trailing slash). Used as a hint to derive defaults.
# Example: https://app.example.com
REACT_APP_FRONTEND_URL=http://localhost:3000

# WebSocket base URL (ws:// or wss://). Leave blank to disable.
# Example: ws://localhost:5001
REACT_APP_WS_URL=

# Node environment exposed to the app (development|staging|production)
REACT_APP_NODE_ENV=development

# Disable Next.js telemetry (kept for compatibility across stacks). True/False
REACT_APP_NEXT_TELEMETRY_DISABLED=true

# Controls CRA source map generation in builds. True to include source maps.
REACT_APP_ENABLE_SOURCE_MAPS=true

# Port for the frontend dev server (CRA). Default 3000.
REACT_APP_PORT=3000

# Trust proxy headers (for setups behind proxies). True/False
REACT_APP_TRUST_PROXY=false

# Log level for client-side logs: debug|info|warn|error
REACT_APP_LOG_LEVEL=info

# Healthcheck path or absolute URL used by the frontend to verify backend connectivity.
# If relative path, it is joined with REACT_APP_API_BASE.
REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature flags as JSON or CSV. Examples:
# - JSON: {"newUI": true, "aiInsights": false}
# - CSV: newUI,aiInsights
REACT_APP_FEATURE_FLAGS=

# Enables experimental features globally. True/False
REACT_APP_EXPERIMENTS_ENABLED=false
